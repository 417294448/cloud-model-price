    "deepseek-v4-flash": {
        "litellm_provider": "deepseek",
        "mode": "chat",
        "source": "https://api-docs.deepseek.com/quick_start/pricing/",
        "notes": "Model version: DeepSeek-V4-Flash-0731\nPricing is dual-rate: PEAK hours are 01:00-04:00 and 06:00-10:00 UTC; all other hours are OFF-PEAK (half of peak). Values in this entry use PEAK rates.\nOff-peak rates: input_cache_hit=$0.007/1M, input_cache_miss=$0.22/1M, output=$0.66/1M\nConcurrency limit: 2500\nSupports both non-thinking and thinking (default) modes; thinking output billed as regular output tokens\nFIM Completion (Beta): available in non-thinking mode only\nBase URL (OpenAI format): https://api.deepseek.com\nBase URL (Anthropic format): https://api.deepseek.com/anthropic\nSupports Chat Prefix Completion (Beta)\nSupports Responses API and Anthropic API",
        "max_input_tokens": 1000000,
        "max_output_tokens": 384000,
        "max_tokens": 384000,
        "input_cost_per_token": 4.4e-07,
